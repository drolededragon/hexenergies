{
  "schemaVersion": 1,
  "id": "hexenergies",
  "version": "${version}",
  "name": "Hexenergies",
  "description": "Hexenergies is an addon for Hex Casting focused on interaction with technology mods.",
  "authors": [
    "drolededragon"
  ],
  "contact": {
    "homepage": "https://drolededragon.github.io/hexenergies",
    "sources": "https://github.com/drolededragon/hexenergies"
  },
  "license": "MIT",
  "icon": "assets/hexenergies/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "net.drolededragon.hexenergies.fabric.FabricHexenergies"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "net.drolededragon.hexenergies.fabric.FabricHexenergiesClient"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "net.drolededragon.hexenergies.fabric.FabricHexenergiesModMenu"
    }]
  },
  "mixins": [
    "hexenergies-common.mixins.json",
    "hexenergies-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting_dependency}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
