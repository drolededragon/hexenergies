{
  "schemaVersion": 1,
  "id": "hextech",
  "version": "${version}",
  "name": "Hextech",
  "description": "Hextech is an addon for Hex Casting focused on interaction with technology mods.",
  "authors": [
    "drolededragon"
  ],
  "contact": {
    "homepage": "https://drolededragon.github.io/hextech",
    "sources": "https://github.com/drolededragon/hextech"
  },
  "license": "MIT",
  "icon": "assets/hextech/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "net.drolededragon.hextech.fabric.FabricHextech"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "net.drolededragon.hextech.fabric.FabricHextechClient"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "net.drolededragon.hextech.fabric.FabricHextechModMenu"
    }]
  },
  "mixins": [
    "hextech-common.mixins.json",
    "hextech-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting_dependency}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
